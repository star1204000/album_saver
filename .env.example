# ============================================================
# 夏日记忆 · 云同步配置模板（Supabase 一站式，免绑卡）
# 复制本文件为 .env.local 并填写真实值（.env.local 不会被提交到 git）
#
# 规则：三项全部填齐 → 云同步模式（多端实时协同）
#       留空任意一项 → 纯本地模式（数据存本机浏览器，功能完整可单机使用）
# ============================================================

# ---------- Supabase（元数据 + Storage 照片存储 + Realtime 推送，一个服务全包）----------
# Dashboard → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx

# ---------- Storage 桶名 ----------
# 前提：supabase_schema.sql 已在 SQL Editor 执行（脚本末尾会自动创建名为 photos 的公开桶）
# 若你在控制台手动建了别的名字，改成那个名字即可；默认 photos 不用改
VITE_STORAGE_BUCKET=photos
